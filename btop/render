#!/usr/bin/env bash
set -euo pipefail

MODULE_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
MODE="${THEMY_MODE:-dark}"
STAGE="${THEMY_STAGE_DIR:-}"
PALETTE="${THEMY_PALETTE:-}"

if [[ -z "$PALETTE" || ! -f "$PALETTE" ]]; then
  for candidate in     "${THEMY_STATE_DIR:-$HOME/.local/state/themy}/current/palette.json"     "${XDG_STATE_HOME:-$HOME/.local/state}/themy/current/palette.json"     "${XDG_CONFIG_HOME:-$HOME/.config}/themy/palette.json"     "$HOME/.config/themy/palette.json"; do
    if [[ -f "$candidate" ]]; then
      PALETTE="$candidate"
      break
    fi
  done
fi

TEMPLATE="$MODULE_DIR/templates/${MODE}.theme"
if [[ ! -f "$TEMPLATE" ]]; then
  TEMPLATE="$MODULE_DIR/templates/dark.theme"
fi

if [[ -n "$STAGE" ]]; then
  OUTPUT="$STAGE/themy.theme"
else
  OUTPUT="$MODULE_DIR/themy.theme"
fi

python3 "$MODULE_DIR/render.py" "$TEMPLATE" "$OUTPUT" "$PALETTE" "$MODE"

if [[ -n "$STAGE" ]]; then
  printf 'ok
' > "$STAGE/.module-ok"
fi
