#!/usr/bin/env bash
set -euo pipefail
if command -v dolphin >/dev/null 2>&1; then
  printf '  OK   %-14s %s
' Dolphin "$(command -v dolphin)"
fi
if command -v qt5ct >/dev/null 2>&1; then
  printf '  OK   %-14s %s
' qt5ct "$(command -v qt5ct)"
fi
if command -v qt6ct >/dev/null 2>&1; then
  printf '  OK   %-14s %s
' qt6ct "$(command -v qt6ct)"
fi
printf '  OK   %-14s %s
' 'KDE schemes' "${XDG_DATA_HOME:-$HOME/.local/share}/color-schemes"
